      tr[u].t = t;\\n+        int v = (a >> k) & 1;\\n+        if (!((d >> k) & 1)) {\\n+            tr[u].ch[v ^ 1] = -t;\\n+            add(tr[u].ch[v], k - 1, max(lim, f[k][v ^ 1]), a, d, t);\\n+        } else {\\n+            v ^= 1;\\n+            add(tr[u].ch[v], k - 1, max(lim, f[k][v ^ 1]), a, d, t);\\n+        }\\n+    }\\n+    int query(int &u, int k, int lim, int a) {\\n+        clear(u, k, lim);\\n+        if (!u) return V;\\n+        if (u < 0) {\\n+            int t = -u, res = 0;\\n+            for (int j = k; j >= 0; --j) {\\n+                if (f[j][0] > t) res |= a & (1 << j);\\n+                else if (f[j][1] > t) res |= (a ^ (V - 1)) & (1 << j);\\n+            }\\n+            return res;\\n+        }\\n+        int v = (a >> k) & 1;\\n+        int res = query(tr[u].ch[v], k - 1, max(lim, f[k][v ^ 1]), a);\\n+        if (res != V) return res;\\n+        v ^= 1;\\n+        res = query(tr[u].ch[v], k - 1, max(lim, f[k][v ^ 1]), a);\\n+        if (res != V) return res | (1 << k);\\n+        u = 0;\\n+        return V;\\n+    }\\n+} s, q;\\n+\\n+void solve() {\\n+    int n = read(), a = read(), g = 1, d = 0;\\n+    int mask = 0, val = 0;\\n+    tot = 0;\\n+    s.init();\\n+    q.init();\\n+    s.rt = -1;\\n+    for (int i = 2; i <= n; ++i) {\\n+        int b = read(), z = a ^ b;\\n+        bool inc = false;\\n+        if (z) {\\n+            int k = 31 - __builtin_clz((unsigned) z);\\n+            int v = (a >> k) & 1, bit = 1 << k;\\n+            if ((mask & bit) && (((val >> k) & 1) != v)) {\\n+                ++g;\\n+                mask = val = 0;\\n+                inc = true;\\n+            } else {\\n+                mask |= bit;\\n+                if (v) val |= bit;\\n+            }\\n+            s.modify(k, v, i);\\n+            q.modify(k, v, i);\\n+        }\\n+        if (inc) {\\n+            swap(s, q);\\n+            q.init();\\n+        }\\n+        if (d < V) {\\n+            if (inc) s.add(s.rt, B - 1, 0, b, d, i);\\n+          